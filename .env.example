PORT=3000
NODE_ENV=development

# 1. Chạy local với SQLite:
DATABASE_URL=sqlite:./data/english_learning.sqlite

# 2. Chạy online trên Render với PostgreSQL (Supabase / Render Postgres / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# 3. Groq AI API (Chính - hỗ trợ nhiều key xoay vòng cách nhau bằng dấu phẩy):
GROQ_API_KEYS=gsk_your_groq_key_1,gsk_your_groq_key_2

# 4. Google Gemini AI API (Dự phòng):
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
